PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=lightyouth
DB_PASS=lightyouth
DB_NAME=lightyouth
# true = TypeORM auto-creates tables. Switch to migrations before going to production.
DB_SYNC=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used for "today" and streak calculations
APP_TIMEZONE=Africa/Cairo

# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=

# Used by `npm run seed` to create an admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Where sermon PDFs are stored (served at /files/<name>.pdf). Back this folder up.
UPLOAD_DIR=./uploads
